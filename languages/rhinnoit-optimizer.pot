#: includes/class-settings.php
msgid "Navigation"
msgstr ""

#: includes/class-settings.php
msgid "Preload pages on hover"
msgstr ""

#: includes/class-settings.php
msgid "Starts loading a link when the pointer rests on it, so the page often opens faster."
msgstr ""

#: includes/class-settings.php
msgid "Page head"
msgstr ""

