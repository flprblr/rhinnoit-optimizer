msgstr ""

#: includes/class-settings.php
msgid "Remove the shortlink"
msgstr ""

#: includes/class-settings.php
msgid "Removes a short version of the page's address from the page code."
msgstr ""

#: includes/class-settings.php
msgid "Remove the oEmbed links"
msgstr ""

