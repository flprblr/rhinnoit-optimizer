msgid "Saves a download per small sheet and shows text while the font loads."
msgstr ""

#: includes/class-settings.php
msgid "Avoid outdated styles in browsers"
msgstr ""

#: includes/class-settings.php
msgid "Browsers download generated styles again when they change, instead of using old copies."
msgstr ""

#: includes/class-settings.php
msgid "Block styles"
msgstr ""

#: includes/class-settings.php
msgid "Remove global styles"
msgstr ""

