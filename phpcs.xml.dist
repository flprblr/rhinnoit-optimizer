<?xml version="1.0"?>
<ruleset name="Optimizer">
	<description>Coding standards for the plugin.</description>

	<file>.</file>

	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/phpstan-bootstrap.php</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg value="ps"/>

	<rule ref="WooCommerce-Core"/>

	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.3-"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="rhinnoit-optimizer"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ropt"/>
				<!-- The renamer rewrites this one through the constant prefix, which is a
				separate argument: CHKTW and chktw happen to match, CHECKOUT_TWEAKS and
				chktw do not, and without it every constant in the new plugin is a phpcs
				error phpcbf cannot fix. -->
				<element value="ROPT"/>
				<element value="RhinnoIT\Optimizer"/>
			</property>
		</properties>
	</rule>

	<!-- Capabilities registered by WooCommerce, not by core. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>
</ruleset>
